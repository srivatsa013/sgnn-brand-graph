    "per_ecosystem_results_enter_holm_family": false
  },
  "h1_decision_table": {
    "forbidden_wording": ["no spillover"],
    "first_matching_row_wins": [
      {"if": "matched_pairs < 10 OR distinct_rewirings = 0", "label": "not estimable"},
      {"if": "placebo_invalid OR balance_invalid", "label": "method failed"},
      {"if": "bootstrap_ci_entirely_inside_[-0.05, 0.05]", "label": "no meaningful effect"},
      {"if": "pair_holm_rejects AND rewiring_holm_rejects AND estimate > 0 AND ci_excludes_0", "label": "supported"},
      {"if": "pair_holm_rejects AND rewiring_holm_does_not_reject AND estimate > 0 AND ci_excludes_0", "label": "differs from controls but not graph-specific"},
      {"if": "everything_else", "label": "inconclusive"}
    ],
    "inconclusive_covers": [
      "ci_extends_beyond_[-0.05, 0.05] and the supported and graph-specific rows do not match",
      "non_significant_result_when_pooled_event_count_is_below_the_halfwidth_cutoff"
    ]
  },
  "splits": {
    "rule": "chronological_by_event_t0",
    "train_fraction": 0.60,
    "val_fraction": 0.20,
    "test_fraction": 0.20,
    "min_events_for_holdout_split": 15,
    "below_15_events": "leave_one_event_out",
    "loeo_inner_val": "chronologically_last_20_percent_of_training_events_at_least_1",
    "loeo_fixed_epochs_if_train_events_below": 5,
    "loeo_fixed_epochs": 50,
    "leave_one_ecosystem_out": "always_reported_as_robustness",
    "random_split_forbidden": true
  },
  "gnn": {
    "task": "predict_same_source_post_minus_pre_shift_of_one_hop_structural_neighbors",
    "loss": "huber",
    "huber_delta": 0.5,
    "metrics": ["mae", "rmse", "sign_accuracy"],
    "selection_metric": "val_mae",
    "seeds": [0, 1, 2, 3, 4],
    "hidden_dim_grid": [32, 64],
    "layers_grid": [1, 2],
    "dropout_grid": [0.0, 0.2],
    "learning_rate": 0.001,
    "weight_decay": 0.0001,
    "max_epochs": 200,
    "early_stopping_patience": 20,
    "history_days": 7,
    "missing_feature_fill": 0.0,
    "missing_feature_requires_mask": true,
    "standardize_using": "training_fold_only",
    "targets_exclude_event_node": true,
    "targets_exclude_controls": true,
    "comention_only_neighbors_in_primary_loss": false,
    "baselines": ["no_graph", "unsigned_gcn", "sign_shuffled", "degree_matched_random", "linear_diffusion"],
    "equal_tuning_budget": true,
    "linear_diffusion_is_closed_form_least_squares": true
  },
  "linking": {
    "precision_target": 0.90,
    "audit_sample_per_ecosystem": 200,
    "audit_sample_seed": 0,
    "if_fewer_than_sample": "audit_all_threshold_unchanged"
  },
  "classifier": {
    "domain_hand_label_target_per_ecosystem": 200,
    "report": ["accuracy", "macro_f1"],
    "phase3_gate_macro_f1_min": 0.70,
    "gate_failure_action": "improve_and_retest_before_event_detection"
  },
  "seeds": {
    "global": 0,
    "bootstrap": 0,
    "pair_permutation": 1,
    "rewiring": 2,
    "placebo": 3,
    "linking_audit": 0,
    "model": [0, 1, 2, 3, 4]
  },
  "change_control": {
    "after_this_file_is_approved": "change_only_by_a_dated_entry_in_DECISIONS_LOG.md",
    "phase1_may_change_only_if_daily_rules_cannot_be_applied": ["k_sd", "primary_bin", "min_mentions_event_bin", "min_baseline_observed_bins"],
    "phase1_change_must_happen_before": "any_spillover_outcome_is_computed",
    "forbidden": [
